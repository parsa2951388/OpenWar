# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Grafana Faro collector URL for browser client telemetry (errors, web
# vitals). Leave empty to keep client telemetry off.
FARO_COLLECTOR_URL=

# Independent guest-only hosting (recommended for Open War standalone).
# DOMAIN is the bare public hostname, without scheme or trailing slash.
# API_BASE_URL is the HTTPS origin where the game server also serves /auth and /users.
GAME_ENV=prod
NUM_WORKERS=1
INSTANCE_LETTER=a
API_BASE_URL=https://your-open-war-host.example
SELF_HOSTED_AUTH=true
JWT_KEY_ID=open-war-1
# Generate a persistent Ed25519 PKCS#8 private key. Keep it in the host's secret store.
# Newlines may be stored as literal \n sequences.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_GENERATED_KEY\n-----END PRIVATE KEY-----"
# Optional: configure BOTH values to enforce Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
